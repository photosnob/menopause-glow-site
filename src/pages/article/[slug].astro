export async function getStaticPaths() {
  const { getCollection } = await import('astro:content');
  const entries = await getCollection('articles', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
import { allArticles, articleView, take, featured, trending, inTopic, withTag, byAuthor, topicsSorted, authorsSorted, newestUpdated, isCurrent, topics, authors, tags, topicView, authorView, tagView } from '../../lib/cms';
const SITE = 'https://www.themenopauseglow.com';
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '').replace(/\/$/, '') || '/', SITE).href;
const all = await allArticles();
import ArticleTagsWrapCard from '../../components/cards/ArticleTagsWrapCard.astro';
import Articles6Card21 from '../../components/cards/Articles6Card21.astro';
import Articles8Card from '../../components/cards/Articles8Card.astro';
import { render } from 'astro:content';
const { entry } = Astro.props;
const a = articleView(entry);
const slug = a.slug;
const { Content } = await render(entry);
const ld = {
  '@context': 'https://schema.org', '@type': 'Article', headline: a.name, description: a.descLong, url: a.url,
  image: a.hasImage ? new URL(a.image, SITE).href : undefined,
  datePublished: a.updatedAt.toISOString(), dateModified: a.updatedAt.toISOString(), inLanguage: 'en',
  author: { '@type': 'Person', name: a.authorName, description: a.authorDescShort, image: a.authorPhoto ? new URL(a.authorPhoto, SITE).href : undefined, jobTitle: a.authorRole, url: a.authorUrl },
  articleSection: a.topicName, keywords: a.topicName, publisher: { '@type': 'Organization', name: 'The Menopause Glow' },
};
