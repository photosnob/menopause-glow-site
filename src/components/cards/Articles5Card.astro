---
import { isCurrent } from '../../lib/cms';
const { a } = Astro.props;
---
<div class="article-5-item w-dyn-item" role="listitem"><a class:list={["article-5-link w-inline-block", { "w--current": isCurrent(a.url, Astro.url.pathname) }]} href={a.url} aria-current={isCurrent(a.url, Astro.url.pathname) ? "page" : undefined}><div class="article-5-image"><div class="image-3d-parallax"><div class="_3d-block"><div class="_3d-trigger"><div class="image-animation-trigger"><div class="parallax-animation"><div class="animation-color-bg"></div><img class="cover-image is-parallax" src={a.image} alt="" /></div></div></div></div></div></div><div class="article-5-content"><div class="article-5-categories" data-w-id="6cddcfe7-ba09-0013-4090-9298778b3191" style="opacity:0"><div class="article-5-category"><p class:list={[{ "w-dyn-bind-empty": !(a.topicName) }]}>{a.topicName}</p></div><div class="article-5-category is-featured"><p>Featured</p><img class="icon is-regular" src="/images/6720496df00c13fa7ae008d8_thumb-up-fill0-wght400-grad0-opsz48.svg" loading="lazy" alt="" /></div><div class="article-5-category is-trend"><p>Trend</p><img class="icon is-regular" src="/images/6720496df00c13fa7ae008d9_mode-heat-fill0-wght400-grad0-opsz48.svg" loading="lazy" alt="" /></div></div><h1 class="heading is-article-5-title" data-w-id="1df00e00-0c71-5a3b-4fda-de7430616838" style="opacity:0">{a.name}</h1><div data-w-id="565b7838-4c7b-10b9-ad99-205c4a36a75e" style="opacity:0"><div class="circle-button" href="#" data-w-id="8c97a891-7e10-26c9-0a5d-14c3f4bdd069"><div class="circle-button-content"><p class="circle-button-text-1" data-w-id="8c97a891-7e10-26c9-0a5d-14c3f4bdd06b">Read</p></div><img class="circle-button-icon-1" src="/images/6720496df00c13fa7ae00782_arrow-icon-white-4.svg" loading="lazy" alt="" /><div class="circle-button-border-1"></div></div></div></div><div class="article-5-overlay" data-w-id="34581ff6-3e72-92c5-6fa3-0781122c981d" style="opacity:0"></div></a></div>
