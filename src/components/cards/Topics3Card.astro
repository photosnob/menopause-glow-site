---
import { isCurrent } from '../../lib/cms';
const { t } = Astro.props;
---
<div class="topic-3-item w-dyn-item" data-w-id="9acc8ff2-e489-9b03-f5b6-b669da08c532" role="listitem"><a class:list={["topic-3-link-block w-inline-block", { "w--current": isCurrent(t.url, Astro.url.pathname) }]} href={t.url} aria-current={isCurrent(t.url, Astro.url.pathname) ? "page" : undefined}><div class="image-3d-parallax"><div class="_3d-block"><div class="_3d-trigger"><div class="image-animation-trigger"><div class="parallax-animation"><div class="animation-color-bg"></div><img class="cover-image is-parallax" src={t.image} alt="" /></div></div></div></div></div><div class="topic-3-content"><h3 class="heading is-2nd is-topic-3" data-w-id="9acc8ff2-e489-9b03-f5b6-b669da08c536" style="opacity:0">{t.name}</h3><p class="paragraph opacity-70" data-w-id="9acc8ff2-e489-9b03-f5b6-b669da08c537" style="opacity:0">{t.descShort}</p></div><div class="topic-3-button" data-w-id="9acc8ff2-e489-9b03-f5b6-b669da08c538"><div class="circle-button" href="#" data-w-id="9acc8ff2-e489-9b03-f5b6-b669da08c539"><div class="circle-button-content"><p class="circle-button-text-1" data-w-id="9acc8ff2-e489-9b03-f5b6-b669da08c53b">Topic</p></div><img class="circle-button-icon-1" src="/images/6720496df00c13fa7ae00782_arrow-icon-white-4.svg" loading="lazy" alt="" /><div class="circle-button-border-1"></div></div></div><div class="topic-3-overlay-color" data-w-id="9acc8ff2-e489-9b03-f5b6-b669da08c53f" style="opacity:0"></div></a></div>
