---
import { isCurrent } from '../../lib/cms';
const { a } = Astro.props;
---
<div class="articles-8-item w-dyn-item" role="listitem"><div class="articles-8-content"><div class="articles-8-categories"><div class="article-8-categories"><div class:list={["symbol-icon", { "w-condition-invisible": !a.featured }]}><p class="symbol-text">Featured</p><img class="icon is-symbol" src="/images/6720496df00c13fa7ae008d8_thumb-up-fill0-wght400-grad0-opsz48.svg" loading="lazy" alt="" /></div><div class:list={["symbol-icon", { "w-condition-invisible": !a.trend }]}><p class="symbol-text">Trend</p><img class="icon is-symbol is-2nd" src="/images/6720496df00c13fa7ae008d9_mode-heat-fill0-wght400-grad0-opsz48.svg" loading="lazy" alt="" /></div><a class:list={["article-8-category-link w-inline-block", { "w--current": isCurrent(a.topicUrl, Astro.url.pathname) }]} href={a.topicUrl} aria-current={isCurrent(a.topicUrl, Astro.url.pathname) ? "page" : undefined}><p class:list={["article-8-category", { "w-dyn-bind-empty": !(a.topicName) }]}>{a.topicName}</p></a></div></div><a class:list={["articles-8-link w-inline-block", { "w--current": isCurrent(a.url, Astro.url.pathname) }]} href={a.url} aria-current={isCurrent(a.url, Astro.url.pathname) ? "page" : undefined}><p class="article-8-title">{a.name}</p></a><div class="articles-8-author"><img class="article-8-author-image" src={a.authorPhoto} loading="lazy" alt="" /><p class="article-8-author-name">{a.authorName}</p></div></div><div class="article-8-button"><a class:list={["circle-button w-inline-block", { "w--current": isCurrent(a.url, Astro.url.pathname) }]} href={a.url} data-w-id="6e867e74-f6b6-f9d4-4f80-2b500ab7e4fc" aria-current={isCurrent(a.url, Astro.url.pathname) ? "page" : undefined}><div class="circle-button-content"><p class="circle-button-text-1">Read</p></div><img class="circle-button-icon-1" src="/images/6720496df00c13fa7ae00782_arrow-icon-white-4.svg" loading="lazy" alt="" /><div class="circle-button-border-1"></div></a></div></div>
