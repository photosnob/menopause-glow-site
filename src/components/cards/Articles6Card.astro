---
import { isCurrent } from '../../lib/cms';
const { a } = Astro.props;
---
<div class="article-6-item w-dyn-item" role="listitem"><header class="article-6-block" data-w-id="920047a1-917f-97f0-17f7-fff16e8a4e50"><div class="article-6-image-left"><div class="image-3d-parallax"><div class="_3d-block"><div class="_3d-trigger"><div class="image-animation-trigger"><div class="parallax-animation"><div class="animation-color-bg"></div><img class="cover-image is-parallax" src={a.imagePH} alt="" /></div></div></div></div></div></div><div class="article-6-content"><div class="_3d-block-for-text"><div class:list={["article-6-featured", { "w-condition-invisible": !a.featured }]}><img class="icon is-regular" src="/images/6720496df00c13fa7ae008a8_thumb-up-fill0-wght400-grad0-opsz48.svg" loading="lazy" alt="" /><p class="article-6-featured-title">Featured</p></div></div><a class:list={["article-6-link-block w-inline-block", { "w--current": isCurrent(a.url, Astro.url.pathname) }]} href={a.url} aria-current={isCurrent(a.url, Astro.url.pathname) ? "page" : undefined}><div class="_3d-block-for-text"><h2 class="heading is-small-title">{a.name}</h2></div></a><div class="_3d-block-for-text"><p class:list={["paragraph", { "w-dyn-bind-empty": !(a.descShort) }]}>{a.descShort}</p></div><div class="_3d-block-for-text"><a class:list={["button is-black w-inline-block", { "w--current": isCurrent(a.url, Astro.url.pathname) }]} data-w-id="6a5458f7-5feb-88d1-d5d3-ad096053c6cc" href={a.url} aria-current={isCurrent(a.url, Astro.url.pathname) ? "page" : undefined}><div class="button-text">Read</div><div class="button-bg is-2nd-color"></div><img class="icon in-button" src="/images/6720496df00c13fa7ae008ca_trending-flat-fill0-wght400-grad0-opsz48.svg" alt="" /></a></div></div><div class="article-6-image-right"><div class="image-3d-parallax"><div class="_3d-block"><div class="_3d-trigger"><div class="image-animation-trigger"><div class="parallax-animation"><div class="animation-color-bg"></div><img class="cover-image is-parallax" src={a.image2PH} alt="" /></div></div></div></div></div></div></header></div>
