---
import { isCurrent } from '../../lib/cms';
const { u } = Astro.props;
---
<div class="topics-1-authors-item w-dyn-item" role="listitem"><a class:list={["topics-1-author-link w-inline-block", { "w--current": isCurrent(u.url, Astro.url.pathname) }]} data-w-id="a791da45-d916-a446-848e-e0414e7c35f0" style="opacity:0" href={u.url} aria-current={isCurrent(u.url, Astro.url.pathname) ? "page" : undefined}><img class="topics-1-author-image" src={u.photo} loading="lazy" alt="" /><div class="topics-1-author-name" data-w-id="a791da45-d916-a446-848e-e0414e7c35f2"><p>{u.name}</p></div></a></div>
