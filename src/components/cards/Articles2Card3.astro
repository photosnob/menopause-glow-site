---
import { isCurrent } from '../../lib/cms';
const { a } = Astro.props;
---
<div class="article-2-item w-dyn-item" role="listitem"><a class:list={["article-2-link-block w-inline-block", { "w--current": isCurrent(a.url, Astro.url.pathname) }]} aria-label={a.name} data-w-id="b1279f2e-9f4b-0985-f4a0-790e8fb0afb4" href={a.url} aria-current={isCurrent(a.url, Astro.url.pathname) ? "page" : undefined}><div class="article-2-images"><div class="article-2-image is-1st"><div class="image-3d-parallax"><div class="_3d-block"><div class="_3d-trigger"><div class="image-animation-trigger"><div class="parallax-animation"><div class="animation-color-bg"></div><img class="cover-image is-parallax" src={a.image} alt="" /></div></div></div></div></div></div><div class="article-2-image is-2nd" data-w-id="b1279f2e-9f4b-0985-f4a0-790e8fb0afb8"><div class="image-3d-parallax"><div class="_3d-block"><div class="_3d-trigger"><div class="image-animation-trigger"><div class="parallax-animation"><div class="animation-color-bg"></div><img class="cover-image is-parallax" src={a.image2} alt="" /></div></div></div></div></div></div></div><div class="article-2-content"><div class="article-2-categories"><div class="article-2-category"><p class:list={["article-2-category-text", { "w-dyn-bind-empty": !(a.topicName) }]}>{a.topicName}</p></div><div class="article-2-symbols"><div class:list={["symbol-icon", { "w-condition-invisible": !a.featured }]}><p class="symbol-text">Featured</p><img class="icon is-symbol" src="/images/6720496df00c13fa7ae0089c_thumb-up-fill0-wght400-grad0-opsz48.svg" loading="lazy" alt="" /></div><div class="symbol-icon is-2nd"><p class="symbol-text is-2nd">Trend</p><img class="icon is-symbol is-2nd" src="/images/6720496df00c13fa7ae0089e_mode-heat-fill0-wght400-grad0-opsz48-1-.svg" loading="lazy" alt="" /></div></div></div><h2 class="heading is-article-2-title">{a.name}</h2><div class="article-2-author"><img class="article-2-author-image" src={a.authorPhoto} loading="lazy" alt="" /><p class="article-1-author-name">{a.authorName}</p></div></div></a></div>
