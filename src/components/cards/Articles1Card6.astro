nt={isCurrent(a.topicUrl, Astro.url.pathname) ? "page" : undefined}><p class:list={["article-1-category-text", { "w-dyn-bind-empty": !(a.topicName) }]}>{a.topicName}</p></a></div><a class:list={["article-1-link w-inline-block", { "w--current": isCurrent(a.url, Astro.url.pathname) }]} href={a.url} aria-current={isCurrent(a.url, Astro.url.pathname) ? "page" : undefined}><h1 class="heading is-article-1-title">{a.name}</h1></a><a class:list={["article-1-author w-inline-block", { "w--current": isCurrent(a.authorUrl, Astro.url.pathname) }]} href={a.authorUrl} aria-current={isCurrent(a.authorUrl, Astro.url.pathname) ? "page" : undefined}><img class="article-1-author-image" src={a.authorPhoto} loading="lazy" alt="" /><p class="article-1-author-name">{a.authorName}</p></a></div><a class:list={["circle-button w-inline-block", { "w--current": isCurrent(a.url, Astro.url.pathname) }]} href={a.url} data-w-id="3c0cbf37-8177-fa34-1f31-8cee1b267dda" aria-current={isCurrent(a.url, Astro.url.pathname) ? "page" : undefined}><div class="circle-button-content"><p class="circle-button-text-1 is-2nd">Read</p></div><img class="circle-button-icon-1" src="/images/6720496df00c13fa7ae00789_arrow_right_alt_FILL0_wght700_GRAD0_opsz48.svg" loading="lazy" alt="" /><div class="circle-button-border-1 is-2nd"></div></a><div class="article-1-default-bg-color"></div><div class="article-1-link-bg-color" data-w-id="fe7268bd-c09e-d1a6-ea3e-dc2d7ebb9a93" style={`background-color:#edebf3`}></div><div class="article-1-date"><p class="article-1-date-text">{a.updMD}</p><p class="article-1-date-text">{a.updYY}</p></div></div></div>
