---
import { isCurrent } from '../../lib/cms';
const { a } = Astro.props;
---
<div class="article-1-item w-dyn-item" role="listitem"><div class="article-1-flex" id="w-node-_2fcf1bac-d3af-5044-82d3-2447827a2dee-7ae00817" data-w-id="2fcf1bac-d3af-5044-82d3-2447827a2dee"><div class="article-1-default-image"><div class="article-1-sticky"><div class="image-3d-parallax"><div class="_3d-block"><div class="_3d-trigger"><div class="image-animation-trigger"><div class="parallax-animation"><div class="animation-color-bg"></div><img class="cover-image is-parallax" src={a.authorPhoto} alt="" /></div></div></div></div></div></div></div><div class="article-1-image"><div class="article-1-sticky"><img class:list={["cover-image in-article-listing-1", { "w-dyn-bind-empty": true, "w-dyn-bind-empty": !a.image }]} alt="" loading="lazy" data-w-id="2fcf1bac-d3af-5044-82d3-2447827a2df4" src={a.image} /></div></div><div class="article-1-content"><div class="article-1-categories"><div class="article-1-categories"><div class:list={["symbol-icon is-black", { "w-condition-invisible": !a.featured }]}><p class="symbol-text">Featured</p><img class="icon is-symbol" src="/images/6720496df00c13fa7ae008a8_thumb-up-fill0-wght400-grad0-opsz48.svg" loading="lazy" alt="" /></div><div class:list={["symbol-icon is-black", { "w-condition-invisible": !a.trend }]}><p class="symbol-text is-2nd">Trend</p><img class="icon is-symbol is-2nd" src="/images/6720496df00c13fa7ae008a9_mode-heat-fill0-wght400-grad0-opsz48.svg" loading="lazy" alt="" /></div><a class:list={["article-1-category w-inline-block", { "w--current": isCurrent(a.topicUrl, Astro.url.pathname) }]} href={a.topicUrl} aria-current={isCurrent(a.topicUrl, Astro.url.pathname) ? "page" : undefined}><p class:list={["article-1-category-text", { "w-dyn-bind-empty": !(a.topicName) }]}>{a.topicName}</p></a></div></div><a class:list={["article-1-link w-inline-block", { "w--current": isCurrent(a.url, Astro.url.pathname) }]} href={a.url} aria-current={isCurrent(a.url, Astro.url.pathname) ? "page" : undefined}><h2 class="heading is-article-1-title">{a.name}</h2></a></div><a class:list={["circle-button w-inline-block", { "w--current": isCurrent(a.url, Astro.url.pathname) }]} href={a.url} data-w-id="3c0cbf37-8177-fa34-1f31-8cee1b267dda" aria-current={isCurrent(a.url, Astro.url.pathname) ? "page" : undefined}><div class="circle-button-content"><p class="circle-button-text-1 is-2nd">Read</p></div><img class="circle-button-icon-1" src="/images/6720496df00c13fa7ae00789_arrow_right_alt_FILL0_wght700_GRAD0_opsz48.svg" loading="lazy" alt="" /><div class="circle-button-border-1 is-2nd"></div></a><div class="article-1-default-bg-color"></div><div class="article-1-link-bg-color" data-w-id="2fcf1bac-d3af-5044-82d3-2447827a2e09" style={`background-color:#eab1bc`}></div><div class="article-1-date"><p class="article-1-date-text">{a.updMD}</p><p class="article-1-date-text">{a.updYY}</p></div></div></div>
