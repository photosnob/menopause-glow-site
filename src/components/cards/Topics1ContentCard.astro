---
import { isCurrent } from '../../lib/cms';
const { t } = Astro.props;
---
<div class="topics-1-item w-dyn-item" role="listitem"><a class:list={["topics-1-link w-inline-block", { "w--current": isCurrent(t.url, Astro.url.pathname) }]} data-w-id="48566849-282a-058d-1c8a-3380e6383705" style="opacity:0" href={t.url} aria-current={isCurrent(t.url, Astro.url.pathname) ? "page" : undefined}><h3 class="heading is-topics-1-title">{t.name}</h3><p class="description-text-1" data-w-id="48566849-282a-058d-1c8a-3380e6383707">{t.descShort}</p><div class="circle-button" href="#" data-w-id="48566849-282a-058d-1c8a-3380e6383708"><div class="circle-button-content"><p class="circle-button-text-1" data-w-id="48566849-282a-058d-1c8a-3380e638370a">More</p></div><img class="circle-button-icon-1" src="/images/6720496df00c13fa7ae00782_arrow-icon-white-4.svg" loading="lazy" alt="" /><div class="circle-button-border-1"></div></div></a><div class="topics-1-gradient-color" data-w-id="48566849-282a-058d-1c8a-3380e638370e" style="opacity:0"></div><div class="image-3d-parallax"><div class="_3d-block"><div class="_3d-trigger"><div class="image-animation-trigger"><div class="parallax-animation"><div class="animation-color-bg"></div><img class="cover-image is-parallax" src={t.image} alt="" /></div></div></div></div></div></div>
