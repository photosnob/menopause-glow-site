---
import { isCurrent } from '../../lib/cms';
const { a } = Astro.props;
---
<div class="articles-3-item w-dyn-item" role="listitem"><div class="articles-3-flex"><a class:list={["articles-3-image w-inline-block", { "w--current": isCurrent(a.url, Astro.url.pathname) }]} aria-label="Article Link" href={a.url} aria-current={isCurrent(a.url, Astro.url.pathname) ? "page" : undefined}><div class="image-3d-parallax"><div class="_3d-block"><div class="_3d-trigger"><div class="image-animation-trigger"><div class="parallax-animation"><div class="animation-color-bg"></div><img class="cover-image is-parallax" src={a.imagePH} alt="" /></div></div></div></div></div></a><div class="articles-3-content"><a class:list={["articles-3-author w-inline-block", { "w--current": isCurrent(a.authorUrl, Astro.url.pathname) }]} href={a.authorUrl} aria-current={isCurrent(a.authorUrl, Astro.url.pathname) ? "page" : undefined}><img class="articles-3-author-image" alt="" loading="lazy" src={a.authorPhoto} /><p class="paragraph is-small">{a.authorName}</p></a><a class:list={["articles-3-title-link w-inline-block", { "w--current": isCurrent(a.url, Astro.url.pathname) }]} href={a.url} aria-current={isCurrent(a.url, Astro.url.pathname) ? "page" : undefined}><h1 class="heading is-article-3-title">{a.name}</h1></a></div><div class="articles-3-description" id="w-node-_32fd7d99-9996-2951-af55-c325728748b2-7ae0081d"><div class="articles-3-categories"><a class:list={["articles-3-category is-link w-inline-block", { "w--current": isCurrent(a.topicUrl, Astro.url.pathname) }]} href={a.topicUrl} aria-current={isCurrent(a.topicUrl, Astro.url.pathname) ? "page" : undefined}><p class:list={["paragraph is-small", { "w-dyn-bind-empty": !(a.topicName) }]}>{a.topicName}</p></a><div class:list={["articles-3-category is-2nd", { "w-condition-invisible": !a.trend }]}><p class="paragraph is-small">Trend</p><img class="icon is-regular" src="/images/6720496df00c13fa7ae0089e_mode-heat-fill0-wght400-grad0-opsz48-1-.svg" loading="lazy" alt="" /></div><div class:list={["articles-3-category", { "w-condition-invisible": !a.featured }]}><p class="paragraph is-small">Featured</p><img class="icon is-regular" src="/images/6720496df00c13fa7ae0089c_thumb-up-fill0-wght400-grad0-opsz48.svg" loading="lazy" alt="" /></div></div><div class="articles-3-button" id="w-node-_32fd7d99-9996-2951-af55-c325728748be-7ae0081d"><a class:list={["button is-black w-inline-block", { "w--current": isCurrent(a.url, Astro.url.pathname) }]} data-w-id="6a5458f7-5feb-88d1-d5d3-ad096053c6cc" href={a.url} aria-current={isCurrent(a.url, Astro.url.pathname) ? "page" : undefined}><div class="button-text">Read</div><div class="button-bg is-2nd-color"></div><img class="icon in-button" src="/images/6720496df00c13fa7ae008ca_trending-flat-fill0-wght400-grad0-opsz48.svg" alt="" /></a></div></div></div></div>
